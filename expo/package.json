{
  "name": "expo-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start-web": "expo start --web",
    "start-web-dev": "DEBUG=expo* expo start --web",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "verify:backend": "node scripts/verify-backend-config.mjs",
    "smoke:production": "node scripts/production-smoke.mjs",
    "audit:production": "node scripts/audit-production.mjs",
    "verify": "npm run verify:backend && npm test && npm run typecheck && npm run vercel-build && npm run audit:production",
    "vercel-build": "EXPO_NO_TELEMETRY=1 npx expo export -p web --clear"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.8",
    "@expo/vector-icons": "^15.0.3",
    "@nkzw/create-context-hook": "^1.1.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.109.0",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~57.0.9",
    "expo-asset": "~57.0.8",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.8",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-picker": "~57.0.7",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-location": "57.0.7",
    "expo-router": "~57.0.9",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "lucide-react-native": "0.447.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-error-boundary": "^6.1.2",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.0",
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "lucide-react-native": "0.447.0",
    "expo-location": "57.0.7",
    "postcss": "8.5.25",
    "uuid": "11.1.1"
  },
  "private": true
}
