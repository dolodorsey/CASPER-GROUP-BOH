# ============================================
# 2026 CONTROL CENTER - Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values.
# Never commit your .env file to version control.

# ============================================
# SUPABASE (Database & Auth)
# ============================================
# Get these from: https://supabase.com/dashboard/project/_/settings/api
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ============================================
# n8n WORKFLOWS (Kollective Brain)
# ============================================
# Your n8n instance base URL
EXPO_PUBLIC_N8N_BASE_URL=

# Authentication belongs in a server-side function, never in an EXPO_PUBLIC variable.
# Configure N8N_WEBHOOK_TOKEN only in that server-side environment.

# ============================================
# AIRTABLE (SERVER-SIDE ONLY)
# ============================================
# Get these from: https://airtable.com/account
# Configure AIRTABLE_API_KEY and AIRTABLE_BASE_ID in a server-side function.

# ============================================
# OPTIONAL INTEGRATIONS
# ============================================
# Uncomment and fill these as needed for your workflows

# Clay.com API
# CLAY_API_KEY (server-side only)

# Apify API
# APIFY_API_KEY (server-side only)

# OpenAI API
# OPENAI_API_KEY (server-side only)

# ============================================
# ENVIRONMENT CONFIGURATION
# ============================================
# Set to 'development', 'staging', or 'production'
EXPO_PUBLIC_ENV=production

# Enable debug mode for development
# EXPO_PUBLIC_DEBUG_MODE=false
